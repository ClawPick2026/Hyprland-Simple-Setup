# Alsamixer colors for Hyprland Simple Setup ({{variant_label}}).
# Alsamixer accepts only the eight terminal color names; the selected terminal maps them to
# the Catppuccin palette, and "default" keeps the terminal background and text color.
color mixer_frame        blue    default
color mixer_text         default default
color mixer_active       blue    default bold
color ctl_frame          white   default
color ctl_mute           red     default bold
color ctl_nomute         green   default bold
color ctl_capture        red     default bold
color ctl_nocapture      white   default
color ctl_label          default default
color ctl_label_focus    blue    default bold
color ctl_mark_focus     blue    default bold
color ctl_bar_lo         green   green
color ctl_bar_mi         yellow  yellow
color ctl_bar_hi         red     red
color ctl_inactive       white   default
color ctl_label_inactive white   default
color errormsg           red     default bold
color infomsg            blue    default
color textbox            default default
color textfield          blue    default
color menu               default default
color menu_selected      default default reverse
