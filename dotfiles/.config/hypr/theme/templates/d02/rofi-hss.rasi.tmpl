/* Rofi launcher and chooser: {{variant_label}}, generated by hss_theme.py. Do not edit;
   add overrides after the hss-theme region in ~/.config/rofi/config.rasi instead. */
* {
    hss-bg: {{color.bg}};
    hss-surface: {{color.surface0}};
    hss-fg: {{color.fg}};
    hss-fg-muted: {{color.fg_muted}};
    hss-border: {{color.border}};
    hss-accent: {{color.accent}};
    hss-accent-alt: {{color.accent_alt}};
    hss-on-accent: {{color.on_accent}};
    hss-urgent: {{color.error}};
    font: "{{font.ui_family}} {{font.ui_size_pt}}";
    background-color: transparent;
    text-color: @hss-fg;
}

window {
    width: 600px;
    padding: {{metrics.space_m}}px;
    border: {{metrics.border}}px;
    border-color: @hss-accent;
    border-radius: {{metrics.radius_large}}px;
    background-color: @hss-bg;
}

mainbox {
    spacing: {{metrics.space_m}}px;
    children: [ inputbar, message, listview ];
}

inputbar {
    padding: {{metrics.space_s}}px {{metrics.space_m}}px;
    spacing: {{metrics.space_m}}px;
    border: {{metrics.focus_width}}px;
    border-color: @hss-accent;
    border-radius: {{metrics.radius}}px;
    background-color: @hss-surface;
    children: [ prompt, entry ];
}

prompt {
    text-color: @hss-accent;
}

entry {
    placeholder-color: @hss-fg-muted;
    cursor: text;
}

message {
    padding: {{metrics.space_s}}px {{metrics.space_m}}px;
    border-radius: {{metrics.radius}}px;
    background-color: @hss-surface;
}

textbox {
    text-color: @hss-fg;
}

listview {
    lines: 10;
    columns: 1;
    spacing: {{metrics.space_xs}}px;
    fixed-height: false;
    scrollbar: false;
}

element {
    padding: {{metrics.space_s}}px {{metrics.space_m}}px;
    spacing: {{metrics.space_m}}px;
    border: {{metrics.focus_width}}px;
    border-color: transparent;
    border-radius: {{metrics.radius}}px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @hss-fg;
}

element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: @hss-urgent;
}

element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @hss-accent;
}

element selected.normal, element selected.active {
    border-color: @hss-accent-alt;
    background-color: @hss-accent;
    text-color: @hss-on-accent;
}

element selected.urgent {
    background-color: @hss-urgent;
    text-color: @hss-on-accent;
}

element-icon {
    size: {{metrics.icon_size}}px;
    background-color: inherit;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}
