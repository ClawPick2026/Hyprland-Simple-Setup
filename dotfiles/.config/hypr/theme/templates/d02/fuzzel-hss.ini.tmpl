# Fuzzel launcher and chooser: {{variant_label}}, generated by hss_theme.py. Do not edit;
# settings after the hss-theme region in ~/.config/fuzzel/fuzzel.ini take precedence.
[main]
font={{font.ui_family}}:size={{font.ui_size_pt}}

[colors]
background={{color.bg | nohash}}ff
text={{color.fg | nohash}}ff
prompt={{color.accent | nohash}}ff
placeholder={{color.fg_subtle | nohash}}ff
input={{color.fg | nohash}}ff
match={{color.accent | nohash}}ff
selection={{color.accent | nohash}}ff
selection-text={{color.on_accent | nohash}}ff
selection-match={{color.bg_deep | nohash}}ff
counter={{color.fg_subtle | nohash}}ff
border={{color.accent | nohash}}ff

[border]
width={{metrics.border}}
radius={{metrics.radius_large}}
selection-radius={{metrics.radius}}
