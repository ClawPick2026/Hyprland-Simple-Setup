# Dunst notifications: {{variant_label}}, generated by hss_theme.py and replaced on theme
# changes. Put your own settings below this region.
[global]
    font = "{{font.ui_family}} {{font.ui_size_pt}}"
    frame_width = {{metrics.border}}
    frame_color = "{{color.accent}}"
    separator_color = frame
    corner_radius = {{metrics.radius_large}}
    highlight = "{{color.accent}}"
    # Native retention (policy P03): keep at most 100 notifications in history.
    history_length = 100

[urgency_low]
    background = "{{color.bg}}"
    foreground = "{{color.fg_muted}}"
    frame_color = "{{color.border}}"
    highlight = "{{color.fg_muted}}"

[urgency_normal]
    background = "{{color.bg}}"
    foreground = "{{color.fg}}"
    frame_color = "{{color.accent}}"
    highlight = "{{color.accent}}"

[urgency_critical]
    background = "{{color.bg}}"
    foreground = "{{color.fg}}"
    frame_color = "{{color.critical}}"
    highlight = "{{color.critical}}"
    # Do not disturb pauses dunst at level 100; critical notifications still appear.
    override_pause_level = 100

# Sender-marked transient notifications stay out of the history.
[hss_transient_no_history]
    match_transient = yes
    history_ignore = yes
