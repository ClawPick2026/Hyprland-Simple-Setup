# Mako notifications: {{variant_label}}, generated by hss_theme.py. Do not edit; settings after
# the hss-theme region in ~/.config/mako/config take precedence.
font={{font.ui_family}} {{font.ui_size_pt}}
background-color={{color.bg | alpha_hex:@effects.shell_opacity}}
text-color={{color.fg}}
border-color={{color.accent}}
border-size={{metrics.border}}
border-radius={{metrics.radius_large}}
progress-color=over {{color.surface1}}
# Native retention (policy P03): keep at most 100 notifications in history.
max-history=100

[urgency=low]
border-color={{color.border}}

[urgency=critical]
border-color={{color.critical}}

# Do not disturb: ordinary popups are hidden, critical notifications still appear.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
