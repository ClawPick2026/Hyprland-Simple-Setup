-- Generated by hss_theme.py: {{variant_label}}. Loaded with `colorscheme hss` from the theme
-- region in init.lua; do not edit. Rendering never starts Neovim or touches plugins.
vim.o.background = "{{variant}}"
vim.cmd("highlight clear")
if vim.fn.exists("syntax_on") == 1 then
	vim.cmd("syntax reset")
end
vim.g.colors_name = "hss"

local c = {
	bg = "{{color.bg}}",
	bg_alt = "{{color.bg_alt}}",
	bg_deep = "{{color.bg_deep}}",
	surface0 = "{{color.surface0}}",
	surface1 = "{{color.surface1}}",
	surface2 = "{{color.surface2}}",
	fg = "{{color.fg}}",
	muted = "{{color.fg_muted}}",
	subtle = "{{color.fg_subtle}}",
	disabled = "{{color.fg_disabled}}",
	accent = "{{color.accent}}",
	accent_alt = "{{color.accent_alt}}",
	on_accent = "{{color.on_accent}}",
	selection = "{{color.selection_bg}}",
	cursor = "{{terminal.cursor}}",
	red = "{{palette.red}}",
	maroon = "{{palette.maroon}}",
	peach = "{{palette.peach}}",
	yellow = "{{palette.yellow}}",
	green = "{{palette.green}}",
	teal = "{{palette.teal}}",
	sky = "{{palette.sky}}",
	sapphire = "{{palette.sapphire}}",
	blue = "{{palette.blue}}",
	lavender = "{{palette.lavender}}",
	mauve = "{{palette.mauve}}",
	pink = "{{palette.pink}}",
	flamingo = "{{palette.flamingo}}",
	diff_add = "{{palette.green | mix:color.bg:0.8}}",
	diff_change = "{{palette.blue | mix:color.bg:0.8}}",
	diff_delete = "{{palette.red | mix:color.bg:0.8}}",
	diff_text = "{{palette.blue | mix:color.bg:0.6}}",
}

local function hl(name, spec)
	vim.api.nvim_set_hl(0, name, spec)
end

