# Generated by hss_theme.py: {{variant_label}}. Selected by skin= in ~/.config/mc/ini; do not edit.
# True colours need a terminal that reports COLORTERM=truecolor (all five supported terminals do).

[skin]
    description = HSS {{variant_label}}
    truecolors = true

[Lines]
    horiz = ─
    vert = │
    lefttop = ┌
    righttop = ┐
    leftbottom = └
    rightbottom = ┘
    topmiddle = ┬
    bottommiddle = ┴
    leftmiddle = ├
    rightmiddle = ┤
    cross = ┼
    dhoriz = ─
    dvert = │
    dlefttop = ┌
    drighttop = ┐
    dleftbottom = └
    drightbottom = ┘
    dtopmiddle = ┬
    dbottommiddle = ┴
    dleftmiddle = ├
    drightmiddle = ┤

[aliases]
    Main = {{color.bg}}
    MainFg = {{color.fg}}
    Alt = {{color.bg_alt}}
    Deep = {{color.bg_deep}}
    Surface0 = {{color.surface0}}
    Surface1 = {{color.surface1}}
    Selection = {{color.selection_bg}}
    Muted = {{color.fg_muted}}
    Disabled = {{color.fg_disabled}}
    Accent = {{color.accent}}
    OnAccent = {{color.on_accent}}
    Marked = {{color.warning}}
    Error = {{color.error}}
    Success = {{color.success}}
    Link = {{color.link}}

[core]
    _default_ = MainFg;Main
    selected = MainFg;Selection
    marked = Marked;;bold
    markselect = Marked;Selection;bold
    gauge = OnAccent;Accent
    input = MainFg;Surface0
    inputunchanged = Muted;Surface0
    inputmark = OnAccent;Accent
    disabled = Disabled;Alt
    reverse = OnAccent;Accent
    commandlinemark = OnAccent;Accent
    header = Accent;;bold
    shadow = Deep;Deep

[dialog]
    _default_ = MainFg;Alt
    dfocus = OnAccent;Accent
    dhotnormal = Accent;;underline
    dhotfocus = OnAccent;Accent;underline
    dtitle = Accent;;bold

[error]
    _default_ = Main;Error
    errdfocus = MainFg;Main
    errdhotnormal = ;;underline
    errdhotfocus = MainFg;Main;underline
    errdtitle = ;;bold

[filehighlight]
    directory = Accent
    executable = Success
    symlink = {{palette.teal}}
    hardlink =
    stalelink = Error
    device = {{palette.pink}}
    special = {{palette.flamingo}}
    core = Error
    temp = Disabled
    archive = {{palette.mauve}}
    doc = MainFg
    source = {{palette.peach}}
    media = {{palette.sky}}
    graph = {{palette.sapphire}}
    database = {{palette.yellow}}

[menu]
    _default_ = MainFg;Alt
    menusel = OnAccent;Accent
    menuhot = Accent;;underline
    menuhotsel = OnAccent;Accent;underline
    menuinactive = Muted;Alt

[popupmenu]
    _default_ = MainFg;Alt
    menusel = OnAccent;Accent
    menutitle = Accent;;bold

[buttonbar]
    hotkey = MainFg;Main
    button = OnAccent;Accent

[statusbar]
    _default_ = OnAccent;Accent

[help]
    _default_ = MainFg;Alt
    helpbold = Accent;;bold
    helpitalic = {{palette.mauve}};;italic
    helplink = Link;;underline
    helpslink = OnAccent;Accent

[editor]
    _default_ = MainFg;Main
    editbold = Marked;;bold
    editmarked = MainFg;Selection
    editwhitespace = Surface1;Main
    editnonprintable = ;Surface0
    editlinestate = Disabled;Alt
    bookmark = MainFg;Surface1
    bookmarkfound = OnAccent;Accent
    editrightmargin = Disabled;Alt
    editbg = ;Alt
    editframe = Disabled
    editframeactive = Accent
    editframedrag = Marked

[viewer]
    _default_ = MainFg;Main
    viewbold = Accent;;bold
    viewunderline = Link;;underline
    viewselected = OnAccent;Accent

[diffviewer]
    added = MainFg;{{palette.green | mix:color.bg:0.7}}
    changedline = MainFg;{{palette.blue | mix:color.bg:0.8}}
    changednew = MainFg;{{palette.green | mix:color.bg:0.7}}
    changed = MainFg;{{palette.blue | mix:color.bg:0.7}}
    removed = MainFg;{{palette.red | mix:color.bg:0.7}}
    error = Main;Error

[widget-panel]
    sort-up-char = ↑
    sort-down-char = ↓
    hiddenfiles-show-char = •
    hiddenfiles-hide-char = ○
    history-prev-item-char = «
    history-next-item-char = »
    history-show-list-char = ^
    filename-scroll-left-char = «
    filename-scroll-right-char = »

[widget-scrollbar]
    first-vert-char = ↑
    last-vert-char = ↓
    first-horiz-char = «
    last-horiz-char = »
    current-char = ■
    background-char = ▒

[widget-editor]
    window-state-char = ↕
    window-close-char = ✕
