" Generated by hss_theme.py: {{variant_label}}. Loaded with :colorscheme hss from the theme
" region in ~/.config/vim/vimrc; do not edit. GUI colours apply with 'termguicolors';
" otherwise the ANSI cterm values follow the terminal palette.
set background={{variant}}
hi clear
if exists('syntax_on')
  syntax reset
endif
let g:colors_name = 'hss'

hi Normal       guifg={{color.fg}} guibg={{color.bg}} ctermfg=NONE ctermbg=NONE cterm=NONE gui=NONE
hi Comment      guifg={{color.fg_subtle}} ctermfg=8 gui=italic cterm=NONE
hi Constant     guifg={{palette.peach}} ctermfg=3
hi String       guifg={{palette.green}} ctermfg=2
hi Character    guifg={{palette.teal}} ctermfg=6
hi Identifier   guifg={{palette.flamingo}} ctermfg=NONE cterm=NONE
hi Function     guifg={{palette.blue}} ctermfg=4
hi Statement    guifg={{palette.mauve}} ctermfg=5 gui=NONE cterm=NONE
hi Operator     guifg={{palette.sky}} ctermfg=6
hi PreProc      guifg={{palette.pink}} ctermfg=5
hi Type         guifg={{palette.yellow}} ctermfg=3 gui=NONE cterm=NONE
hi Special      guifg={{palette.pink}} ctermfg=5
hi Delimiter    guifg={{color.fg_muted}} ctermfg=NONE
hi Underlined   gui=underline cterm=underline
hi Ignore       guifg={{color.fg_disabled}} ctermfg=8
hi Error        guifg={{palette.red}} guibg=NONE ctermfg=1 ctermbg=NONE
hi Todo         guifg={{color.bg}} guibg={{palette.yellow}} ctermfg=NONE ctermbg=3 gui=bold cterm=bold
hi LineNr       guifg={{color.fg_disabled}} ctermfg=8
hi CursorLineNr guifg={{color.accent}} ctermfg=4 gui=bold cterm=bold
hi CursorLine   guibg={{color.surface0}} ctermbg=NONE cterm=underline gui=NONE
hi ColorColumn  guibg={{color.surface0}} ctermbg=0
hi SignColumn   guifg={{color.fg_disabled}} guibg={{color.bg}} ctermbg=NONE
hi Folded       guifg={{color.accent}} guibg={{color.surface0}} ctermfg=4 ctermbg=NONE
hi Visual       guibg={{color.selection_bg}} ctermbg=NONE cterm=reverse gui=NONE
hi Search       guifg={{color.fg}} guibg={{color.surface1}} ctermfg=NONE ctermbg=NONE cterm=reverse
hi IncSearch    guifg={{color.bg}} guibg={{color.accent}} ctermfg=4 cterm=reverse gui=NONE
hi MatchParen   guifg={{palette.peach}} guibg={{color.surface1}} ctermfg=3 ctermbg=NONE gui=bold cterm=bold
hi Pmenu        guifg={{color.fg}} guibg={{color.bg_alt}} ctermfg=NONE ctermbg=0
hi PmenuSel     guifg={{color.fg}} guibg={{color.surface1}} ctermfg=NONE ctermbg=NONE cterm=reverse gui=bold
hi StatusLine   guifg={{color.fg}} guibg={{color.bg_alt}} cterm=reverse gui=NONE
hi StatusLineNC guifg={{color.fg_disabled}} guibg={{color.bg_alt}} ctermfg=8 cterm=reverse gui=NONE
hi TabLine      guifg={{color.fg_muted}} guibg={{color.bg_deep}} ctermfg=8 ctermbg=NONE cterm=NONE gui=NONE
hi TabLineFill  guibg={{color.bg_deep}} ctermbg=NONE cterm=NONE gui=NONE
hi TabLineSel   guifg={{color.fg}} guibg={{color.bg}} gui=bold cterm=bold,reverse
hi VertSplit    guifg={{color.bg_deep}} guibg={{color.bg}} ctermfg=8 ctermbg=NONE cterm=NONE gui=NONE
hi ErrorMsg     guifg={{palette.red}} guibg=NONE ctermfg=1 ctermbg=NONE gui=bold cterm=bold
hi WarningMsg   guifg={{palette.yellow}} ctermfg=3
hi MoreMsg      guifg={{color.accent}} ctermfg=4
hi ModeMsg      guifg={{color.fg}} gui=bold cterm=bold
hi Question     guifg={{color.accent}} ctermfg=4
hi Title        guifg={{color.accent}} ctermfg=4 gui=bold cterm=bold
hi Directory    guifg={{color.accent}} ctermfg=4
hi NonText      guifg={{color.fg_disabled}} ctermfg=8
hi SpecialKey   guifg={{color.surface2}} ctermfg=8
hi EndOfBuffer  guifg={{color.bg}} ctermfg=NONE
hi DiffAdd      guibg={{palette.green | mix:color.bg:0.8}} ctermfg=2 ctermbg=NONE
hi DiffChange   guibg={{palette.blue | mix:color.bg:0.8}} ctermfg=4 ctermbg=NONE
hi DiffDelete   guifg={{palette.red}} guibg={{palette.red | mix:color.bg:0.8}} ctermfg=1 ctermbg=NONE
hi DiffText     guibg={{palette.blue | mix:color.bg:0.6}} ctermfg=4 ctermbg=NONE cterm=bold
hi SpellBad     guisp={{palette.red}} gui=undercurl ctermfg=1 cterm=underline
hi SpellCap     guisp={{palette.yellow}} gui=undercurl ctermfg=3 cterm=underline
