" Generated by hss_theme.py: {{variant_label}}. Selected with `colorscheme hss` in vifmrc;
" do not edit. vifm uses the gui values only for TERM *-direct; otherwise the ANSI cterm
" values follow the terminal palette in both variants.
highlight clear
highlight Win        cterm=none ctermfg=default ctermbg=default gui=none guifg={{color.fg}} guibg={{color.bg}}
highlight OtherWin   cterm=none ctermfg=default ctermbg=default gui=none guifg={{color.fg}} guibg={{color.bg}}
highlight AuxWin     cterm=none ctermfg=default ctermbg=default gui=none guifg={{color.fg}} guibg={{color.bg_alt}}
highlight Directory  cterm=bold ctermfg=blue ctermbg=default gui=bold guifg={{color.accent}} guibg={{color.bg}}
highlight Link       cterm=bold ctermfg=cyan ctermbg=default gui=bold guifg={{palette.teal}} guibg={{color.bg}}
highlight BrokenLink cterm=bold ctermfg=red ctermbg=default gui=bold guifg={{color.error}} guibg={{color.bg}}
highlight HardLink   cterm=none ctermfg=yellow ctermbg=default gui=none guifg={{color.warning}} guibg={{color.bg}}
highlight Socket     cterm=bold ctermfg=magenta ctermbg=default gui=bold guifg={{palette.pink}} guibg={{color.bg}}
highlight Device     cterm=bold ctermfg=red ctermbg=default gui=bold guifg={{palette.maroon}} guibg={{color.bg}}
highlight Fifo       cterm=bold ctermfg=cyan ctermbg=default gui=bold guifg={{palette.sky}} guibg={{color.bg}}
highlight Executable cterm=bold ctermfg=green ctermbg=default gui=bold guifg={{color.success}} guibg={{color.bg}}
highlight Selected   cterm=bold ctermfg=magenta ctermbg=default gui=bold guifg={{palette.mauve}} guibg={{color.surface0}}
highlight CurrLine   cterm=bold,reverse ctermfg=default ctermbg=default gui=bold guifg={{color.fg}} guibg={{color.selection_bg}}
highlight OtherLine  cterm=reverse ctermfg=default ctermbg=default gui=none guifg={{color.fg}} guibg={{color.surface0}}
highlight TopLine    cterm=none ctermfg=default ctermbg=default gui=none guifg={{color.fg_muted}} guibg={{color.bg_alt}}
highlight TopLineSel cterm=bold ctermfg=blue ctermbg=default gui=bold guifg={{color.accent}} guibg={{color.bg_alt}}
highlight StatusLine cterm=reverse ctermfg=default ctermbg=default gui=none guifg={{color.fg}} guibg={{color.bg_alt}}
highlight WildMenu   cterm=reverse ctermfg=blue ctermbg=default gui=none guifg={{color.on_accent}} guibg={{color.accent}}
highlight CmdLine    cterm=none ctermfg=default ctermbg=default gui=none guifg={{color.fg}} guibg={{color.bg}}
highlight ErrorMsg   cterm=bold ctermfg=red ctermbg=default gui=bold guifg={{color.error}} guibg={{color.bg}}
highlight Border     cterm=none ctermfg=default ctermbg=default gui=none guifg={{color.border}} guibg={{color.bg}}
highlight JobLine    cterm=reverse ctermfg=default ctermbg=default gui=none guifg={{color.fg}} guibg={{color.surface0}}
highlight SuggestBox cterm=bold ctermfg=default ctermbg=default gui=bold guifg={{color.fg}} guibg={{color.bg_alt}}
highlight CmpMismatch cterm=bold ctermfg=red ctermbg=default gui=bold guifg={{color.error}} guibg={{color.bg}}
highlight TabLine    cterm=none ctermfg=default ctermbg=default gui=none guifg={{color.fg_muted}} guibg={{color.bg_alt}}
highlight TabLineSel cterm=bold,reverse ctermfg=default ctermbg=default gui=bold guifg={{color.on_accent}} guibg={{color.accent}}
