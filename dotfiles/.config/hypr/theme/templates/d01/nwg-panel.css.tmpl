/* Generated by hss_theme.py for nwg-panel (bar and dock): {{variant_label}}.
   Edit tokens.json instead; add your own rules after the region in hss-style.css. */
@define-color hss_bg {{color.bg}};
@define-color hss_bg_alt {{color.bg_alt}};
@define-color hss_bg_shell {{color.bg | rgba:@effects.shell_opacity}};
@define-color hss_fg {{color.fg}};
@define-color hss_fg_muted {{color.fg_muted}};
@define-color hss_border {{color.border}};
@define-color hss_accent {{color.accent}};
@define-color hss_on_accent {{color.on_accent}};
@define-color hss_focus {{color.focus}};
@define-color hss_hover {{color.hover}};
@define-color hss_warning {{color.warning}};
@define-color hss_active_bg {{color.accent | mix:color.bg:0.78}};

* {
  font-family: "{{font.ui_family}}", "{{font.mono_family}}", "{{font.symbol_fallback}}";
  font-size: {{font.bar_size_px | px}};
}

#hss-bar {
  background: transparent;
  color: @hss_fg;
}

#hss-dock {
  background: @hss_bg_shell;
  color: @hss_fg;
  border-top: 1px solid @hss_border;
}

#hss-module,
#hss-button,
#hss-tray,
#hss-submap,
#hyprland-workspaces {
  background: @hss_bg_shell;
  color: @hss_fg;
  border: 1px solid @hss_border;
  border-radius: {{metrics.radius | px}};
  padding: {{metrics.space_xs | px}} {{metrics.space_m | px}};
  margin-top: {{metrics.space_s | px}};
  box-shadow: none;
}

#hss-label {
  color: @hss_fg;
}

#hss-module:hover,
#hss-button:hover {
  background: @hss_hover;
  border-color: @hss_focus;
}

#hss-button:focus {
  border-color: @hss_focus;
}

#hss-submap {
  color: @hss_accent;
  font-style: italic;
}

#hyprland-workspaces-item {
  color: @hss_fg_muted;
  padding: 0 {{metrics.space_s | px}};
  border-radius: {{metrics.radius_small | px}};
}

#workspace-occupied {
  color: @hss_fg;
}

#task-box,
#pinned-button {
  background: transparent;
  border-radius: {{metrics.radius | px}};
  padding: {{metrics.space_xs | px}} {{metrics.space_s | px}};
}

#task-box:hover,
#pinned-button:hover {
  background: @hss_hover;
}

#task-box-focused {
  background: @hss_active_bg;
  color: @hss_accent;
  border-radius: {{metrics.radius | px}};
  border-bottom: {{metrics.focus_width | px}} solid @hss_accent;
}

tooltip,
menu {
  background: @hss_bg_alt;
  color: @hss_fg;
  border: 1px solid @hss_border;
  border-radius: {{metrics.radius | px}};
}

menu menuitem:hover {
  background: @hss_hover;
}
