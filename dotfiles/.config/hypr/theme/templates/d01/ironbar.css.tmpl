/* Generated by hss_theme.py for Ironbar: {{variant_label}}.
   Edit tokens.json instead; add your own rules after the region in style.css. */
@define-color hss_bg {{color.bg}};
@define-color hss_bg_alt {{color.bg_alt}};
@define-color hss_bg_shell {{color.bg | rgba:@effects.shell_opacity}};
@define-color hss_fg {{color.fg}};
@define-color hss_fg_muted {{color.fg_muted}};
@define-color hss_fg_disabled {{color.fg_disabled}};
@define-color hss_border {{color.border}};
@define-color hss_accent {{color.accent}};
@define-color hss_on_accent {{color.on_accent}};
@define-color hss_focus {{color.focus}};
@define-color hss_hover {{color.hover}};
@define-color hss_warning {{color.warning}};
@define-color hss_critical {{color.critical}};
@define-color hss_success {{color.success}};
@define-color hss_active_bg {{color.accent | mix:color.bg:0.78}};

* {
  font-family: "{{font.ui_family}}", "{{font.mono_family}}", "{{font.symbol_fallback}}";
  font-size: {{font.bar_size_px | px}};
  font-weight: 600;
}

.background {
  background-color: transparent;
}

#bar {
  background-color: transparent;
  color: @hss_fg;
}

#bar .widget {
  background-color: @hss_bg_shell;
  color: @hss_fg;
  border: 1px solid @hss_border;
  border-radius: {{metrics.radius | px}};
  padding: {{metrics.space_xs | px}} {{metrics.space_m | px}};
  margin: {{metrics.space_s | px}} {{metrics.space_xs | px}} 0;
}

#bar button {
  background: none;
  border: none;
  box-shadow: none;
  color: @hss_fg;
  padding: 0 {{metrics.space_xs | px}};
}

#bar .widget:hover {
  background-color: @hss_hover;
  border-color: @hss_focus;
}

.power,
.menu {
  color: @hss_accent;
}

.workspaces .item {
  color: @hss_fg_muted;
  border-radius: {{metrics.radius_small | px}};
  padding: 0 {{metrics.space_m | px}};
}

.workspaces .item.focused {
  background-color: @hss_active_bg;
  color: @hss_accent;
}

.workspaces .item.urgent {
  background-color: @hss_warning;
  color: @hss_on_accent;
}

.bindmode {
  color: @hss_accent;
  font-style: italic;
}

.battery.profile-warning {
  color: @hss_warning;
  border-color: @hss_warning;
}

.battery.profile-critical {
  color: @hss_critical;
  border-color: @hss_critical;
}

.bluetooth.disabled {
  color: @hss_fg_muted;
}

.bluetooth.not-found,
#battery-unavailable {
  color: @hss_fg_disabled;
  border-style: dashed;
}

.popup {
  background-color: @hss_bg_alt;
  color: @hss_fg;
  border: 1px solid @hss_border;
  border-radius: {{metrics.radius | px}};
  padding: {{metrics.space_s | px}};
}

.popup .menu-item {
  background: none;
  border: none;
  border-radius: {{metrics.radius_small | px}};
  color: @hss_fg;
  padding: {{metrics.space_s | px}} {{metrics.space_l | px}};
}

.popup .menu-item:hover,
.popup .menu-item:focus {
  background-color: @hss_hover;
}

tooltip {
  background-color: @hss_bg_alt;
  color: @hss_fg;
  border: 1px solid @hss_border;
  border-radius: {{metrics.radius | px}};
}
