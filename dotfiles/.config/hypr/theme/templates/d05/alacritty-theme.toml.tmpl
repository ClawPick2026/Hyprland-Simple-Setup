# Generated by hss_theme.py: {{variant_label}}. Imported from alacritty.toml ([general] import);
# the importing file is loaded last, so keep colours and font family out of it. Do not edit.
[colors.primary]
foreground = "{{terminal.foreground}}"
background = "{{terminal.background}}"

[colors.cursor]
text = "{{terminal.cursor_text}}"
cursor = "{{terminal.cursor}}"

[colors.vi_mode_cursor]
text = "{{terminal.cursor_text}}"
cursor = "{{color.accent_alt}}"

[colors.selection]
text = "{{terminal.selection_fg}}"
background = "{{terminal.selection_bg}}"

[colors.search]
matches = { foreground = "{{color.bg}}", background = "{{color.fg_muted}}" }
focused_match = { foreground = "{{color.bg}}", background = "{{color.success}}" }

[colors.hints]
start = { foreground = "{{color.bg}}", background = "{{color.warning}}" }
end = { foreground = "{{color.bg}}", background = "{{color.fg_muted}}" }

[colors.footer_bar]
foreground = "{{color.bg}}"
background = "{{color.fg_muted}}"

[colors.normal]
black = "{{terminal.ansi.0}}"
red = "{{terminal.ansi.1}}"
green = "{{terminal.ansi.2}}"
yellow = "{{terminal.ansi.3}}"
blue = "{{terminal.ansi.4}}"
magenta = "{{terminal.ansi.5}}"
cyan = "{{terminal.ansi.6}}"
white = "{{terminal.ansi.7}}"

[colors.bright]
black = "{{terminal.ansi.8}}"
red = "{{terminal.ansi.9}}"
green = "{{terminal.ansi.10}}"
yellow = "{{terminal.ansi.11}}"
blue = "{{terminal.ansi.12}}"
magenta = "{{terminal.ansi.13}}"
cyan = "{{terminal.ansi.14}}"
white = "{{terminal.ansi.15}}"

[font.normal]
family = {{font.mono_family | toml}}
