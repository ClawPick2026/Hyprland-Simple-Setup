[Desktop Entry]
Type=Application
Version=1.5
Name=Terminal Text Editor
GenericName=Text Editor
Comment=Open text files with the selected terminal editor in the selected terminal
Exec=sh -c "exec \\"\\$HOME/.config/hypr/scripts/role_exec.sh\\" tui_editor -- \\"\\$@\\"" hss-tui-editor %F
Icon=accessories-text-editor
Terminal=false
NoDisplay=true
StartupNotify=false
Categories=Utility;TextEditor;
MimeType=text/plain;application/x-shellscript;
X-HSS-Managed=true
